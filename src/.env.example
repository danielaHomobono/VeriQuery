# ============================================================================
# FORENSIC DATA GUARDIAN - Environment Configuration
# ============================================================================

# Azure Configuration
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
AZURE_KEY_VAULT_NAME=guardian-vault-2026
AZURE_KEYVAULT_URL=https://guardian-vault-2026.vault.azure.net/

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-instance.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_MODEL=gpt-4

# Guardian Database Configuration (PostgreSQL)
# This database stores user configurations and sessions
GUARDIAN_DB_HOST=localhost
GUARDIAN_DB_PORT=5432
GUARDIAN_DB_NAME=guardian_db
GUARDIAN_DB_USER=guardian
GUARDIAN_DB_PASSWORD=your_password

# Default Database Configuration (for testing)
DB_TYPE=sqlserver
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ContosoV210k
DB_USER=sa
DB_PASSWORD=your_password

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8889
DEBUG=true
LOG_LEVEL=info
